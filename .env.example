# Токен бота от @BotFather
BOT_TOKEN=

# Username чужого ПУБЛИЧНОГО канала столовой, без @ (например stolovaybolshaytarelka).
# Бот сам проверяет открытую веб-версию этого канала на новое фото —
# вступать в канал не нужно, пересылать фото вручную тоже не нужно.
SOURCE_CHANNEL=

# Когда проверять канал — по будням (Пн-Пт), время по этому часовому поясу.
TIMEZONE=Europe/Moscow
CHECK_HOUR=10
CHECK_MINUTE=0

# ID канала, если бот СОСТОИТ в своём канале как участник/админ — обычно не нужно.
CHANNEL_ID=

# Telegram ID администраторов через запятую (узнать свой id можно у @userinfobot)
ADMIN_IDS=

# ---- Распознавание меню через VLM (мультимодальную модель) ----
# Необязательно. Если задать VLM_BASE_URL и VLM_MODEL, меню будет читать модель
# по OpenAI-совместимому API (видит фото целиком, распознаёт и салаты/супы/
# горячее, и гарниры/напитки). При любой ошибке бот сам откатится на локальный
# Tesseract OCR. Если оставить пустыми — работает только Tesseract, как раньше.
# VLM_BASE_URL — корень API, обычно оканчивается на /v1 (бот добавит /chat/completions).
VLM_BASE_URL=
VLM_API_KEY=
VLM_MODEL=
# Таймаут запроса к модели в секундах (по умолчанию 60).
VLM_TIMEOUT=60
